  <section id="formula" aria-labelledby="formula-h">
    <h2 id="formula-h">Pace, Time and Distance Formulas</h2>
    <p class="tp-note" style="font-size:17px!important"><span class="tp-kbd">pace = time &divide; distance</span><br><span class="tp-kbd">time = pace &times; distance</span><br><span class="tp-kbd">distance = time &divide; pace</span></p><p>Min per km = min per mile &divide; 1.609; speed in mph = 60 &divide; pace in minutes per mile.</p>
  </section>

