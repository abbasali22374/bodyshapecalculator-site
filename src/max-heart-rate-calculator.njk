  <section id="formulas" aria-labelledby="formulas-h">
    <h2 id="formulas-h">Max Heart Rate Formulas</h2>
    <div class="tp-tablewrap"><table class="tp-table"><caption>Formulas for maximum heart rate</caption><thead><tr><th scope="col">Formula</th><th scope="col">Equation</th><th scope="col">Notes</th></tr></thead><tbody><tr><th scope="row">Tanaka (2001)</th><td>208 &minus; 0.7 &times; age</td><td>Most accurate general formula; based on 18,712 people</td></tr><tr><th scope="row">Fox / Haskell</th><td>220 &minus; age</td><td>Simple; overestimates in young and underestimates in older adults</td></tr><tr><th scope="row">Gellish (2007)</th><td>207 &minus; 0.7 &times; age</td><td>Very close to Tanaka</td></tr><tr><th scope="row">Nes (2013, HUNT)</th><td>211 &minus; 0.64 &times; age</td><td>Large Norwegian study</td></tr><tr><th scope="row">Gulati (2010)</th><td>206 &minus; 0.88 &times; age</td><td>Women; lower values at older ages</td></tr></tbody></table></div>
  </section>

