    <figure class="tp-fig"><img src="/assets/images/steps-per-mile-by-height.webp" width="1600" height="900" loading="lazy" decoding="async" alt="Walking and running steps per mile by height from 4 ft 10 in to 6 ft 6 in"><figcaption>Steps per mile fall as height and stride length rise.</figcaption></figure><div class="tp-tablewrap"><table class="tp-table tp-num"><caption>Average walking step length by height</caption><thead><tr><th scope="col">Height</th><th scope="col">Step (men)</th><th scope="col">Step (women)</th><th scope="col">Steps per mile</th></tr></thead><tbody><tr><th scope="row">4 ft 10 in</th><td>24.1 in</td><td>24.0 in</td><td>2,639</td></tr><tr><th scope="row">5 ft 0 in</th><td>24.9 in</td><td>24.8 in</td><td>2,551</td></tr><tr><th scope="row">5 ft 2 in</th><td>25.7 in</td><td>25.6 in</td><td>2,468</td></tr><tr><th scope="row">5 ft 4 in</th><td>26.6 in</td><td>26.4 in</td><td>2,391</td></tr><tr><th scope="row">5 ft 6 in</th><td>27.4 in</td><td>27.3 in</td><td>2,319</td></tr><tr><th scope="row">5 ft 8 in</th><td>28.2 in</td><td>28.1 in</td><td>2,251</td></tr><tr><th scope="row">5 ft 10 in</th><td>29.1 in</td><td>28.9 in</td><td>2,186</td></tr><tr><th scope="row">6 ft 0 in</th><td>29.9 in</td><td>29.7 in</td><td>2,126</td></tr><tr><th scope="row">6 ft 2 in</th><td>30.7 in</td><td>30.6 in</td><td>2,068</td></tr><tr><th scope="row">6 ft 4 in</th><td>31.5 in</td><td>31.4 in</td><td>2,014</td></tr><tr><th scope="row">6 ft 6 in</th><td>32.4 in</td><td>32.2 in</td><td>1,962</td></tr></tbody></table></div>
